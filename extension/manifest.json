{
  "manifest_version": 3,
  "name": "Screen Time Tracker",
  "version": "3.2.0",
  "description": "Professional screen-time insights: site-wise time, categories, goals, alerts, trends & web export. 100% private.",
  "permissions": ["tabs", "storage", "idle", "alarms", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Screen Time Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the Screen Time dashboard"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
